generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model AdminUser {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Category {
  id          String    @id @default(cuid())
  name        String
  slug        String    @unique
  description String?
  products    Product[]
}

model Brand {
  id     String  @id @default(cuid())
  name   String  @unique
  slug   String  @unique
  active Boolean @default(true)

  products Product[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Supplier {
  id      String  @id @default(cuid())
  name    String
  phone   String?
  email   String?
  address String?
  active  Boolean @default(true)

  products Product[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([name])
}

model Product {
  id   String @id @default(cuid())
  name String
  slug String @unique

  // Temporalmente se conserva para migrar los datos existentes
  brand    String
  brandId  String?
  brandRef Brand?  @relation(fields: [brandId], references: [id])

  description     String
  characteristics String

  price     Decimal
  costPrice Decimal @default(0)

  stock    Int @default(0)
  minStock Int @default(0)

  active    Boolean   @default(true)
  deletedAt DateTime?

  categoryId String
  category   Category @relation(fields: [categoryId], references: [id])

  images     ProductImage[]
  reviews    Review[]
  orderItems OrderItem[]

  promotionTargets Promotion[] @relation("PromotionProduct")

  inventoryMoves InventoryMovement[]

  supplierId String?
  supplier   Supplier? @relation(fields: [supplierId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([categoryId])
  @@index([slug])
  @@index([brandId])
  @@index([supplierId])
}

model TaxSetting {
  id      String  @id @default("singleton")
  enabled Boolean @default(false)
  rate    Decimal @default(19)

  updatedAt DateTime @updatedAt
}

model Invoice {
  id            String @id @default(cuid())
  invoiceNumber String @unique

  orderId String @unique
  order   Order  @relation(fields: [orderId], references: [id])

  subtotal   Decimal
  taxEnabled Boolean
  taxRate    Decimal
  taxAmount  Decimal
  total      Decimal

  paymentMethod String

  issuedAt DateTime @default(now())

  @@index([issuedAt])
}

model InventoryMovement {
  id String @id @default(cuid())

  productId String
  product   Product @relation(fields: [productId], references: [id])

  type     String
  quantity Int

  previousStock Int
  newStock      Int

  reason      String?
  referenceId String?

  createdAt DateTime @default(now())

  @@index([productId])
  @@index([createdAt])
  @@index([type])
}

model ProductImage {
  id        String  @id @default(cuid())
  url       String
  alt       String?
  sortOrder Int     @default(0)
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
}

model Promotion {
  id              String   @id @default(cuid())
  title           String
  subtitle        String?
  imageUrl        String?
  linkUrl         String?
  discountPercent Int?
  startsAt        DateTime
  endsAt          DateTime
  active          Boolean  @default(true)
  productId       String?
  product         Product? @relation("PromotionProduct", fields: [productId], references: [id])
  createdAt       DateTime @default(now())
}

model Review {
  id String @id @default(cuid())

  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  orderItemId String    @unique
  orderItem   OrderItem @relation(fields: [orderItemId], references: [id])

  authorName String
  email      String?
  rating     Int
  comment    String
  approved   Boolean @default(true)

  createdAt DateTime @default(now())

  @@index([productId])
}

model SearchLog {
  id String @id @default(cuid())

  query        String
  normalized   String
  resultsCount Int    @default(0)

  createdAt DateTime @default(now())

  @@index([normalized])
  @@index([createdAt])
}

model Order {
  id          String @id @default(cuid())
  orderNumber String @unique

  customerName String
  email        String
  phone        String
  address      String
  notes        String?

  subtotal  Decimal
  taxAmount Decimal @default(0)
  total     Decimal

  status        String @default("PENDIENTE")
  paymentMethod String

  items   OrderItem[]
  invoice Invoice?

  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([status])
}

model OrderItem {
  id String @id @default(cuid())

  orderId String
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  productId String
  product   Product @relation(fields: [productId], references: [id])

  quantity      Int
  priceSnapshot Decimal

  review Review?

  @@index([orderId])
}

model ContactMessage {
  id        String   @id @default(cuid())
  name      String
  email     String
  message   String
  createdAt DateTime @default(now())
}

model SiteSettings {
  id           String   @id @default("singleton")
  whatsapp     String   @default("")
  facebook     String   @default("")
  instagram    String   @default("")
  tiktok       String   @default("")
  email        String   @default("")
  address      String   @default("")
  mapEmbedUrl  String?
  aboutHtml    String   @default("")
  servicesHtml String   @default("")
  updatedAt    DateTime @updatedAt
}
